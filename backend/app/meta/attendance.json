{
  "name": "Attendance",
  "module": "HR",
  "naming_rule": "Prefix",
  "naming_prefix": "ATT-.#####",
  "workflow_state_field": "workflow_state",
  "states": ["Draft", "Submitted", "Cancelled"],
  "track_changes": true,
  "fields": [
    {
      "name": "id",
      "label": "Attendance ID",
      "fieldtype": "text",
      "readonly": true,
      "hidden": true
    },
    {
      "name": "employee_id",
      "label": "Employee Link",
      "fieldtype": "link",
      "options": "Employee",
      "required": true
    },
    {
      "name": "date",
      "label": "Date",
      "fieldtype": "date",
      "required": true
    },
    {
      "name": "status",
      "label": "Attendance Status",
      "fieldtype": "select",
      "options": "Present,Absent,Half Day,On Leave,Holiday",
      "default": "Present",
      "required": true
    },
    {
      "name": "workflow_state",
      "label": "Doc Status",
      "fieldtype": "select",
      "options": "Draft,Submitted,Cancelled",
      "default": "Draft",
      "readonly": true
    }
  ]
}
