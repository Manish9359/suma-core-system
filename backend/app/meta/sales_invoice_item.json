{
  "name": "Sales Invoice Item",
  "module": "Sales",
  "istable": true,
  "fields": [
    {
      "name": "item_code",
      "label": "Item",
      "fieldtype": "link",
      "options": "Product",
      "required": true
    },
    {
      "name": "stock_available",
      "label": "Stock Avail",
      "fieldtype": "float",
      "fetch_from": "item_code.stock",
      "readonly": true
    },
    {
      "name": "qty",
      "label": "Quantity",
      "fieldtype": "int",
      "default": 1,
      "required": true
    },
    {
      "name": "rate",
      "label": "Rate (₹)",
      "fieldtype": "float",
      "fetch_from": "item_code.sell",
      "required": true
    },
    {
      "name": "amount",
      "label": "Amount (₹)",
      "fieldtype": "float",
      "readonly": true
    }
  ]
}
