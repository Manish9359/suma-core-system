{
  "name": "Purchase Order",
  "module": "Buying",
  "naming_rule": "Prefix",
  "naming_prefix": "PO-",
  "workflow_state_field": "status",
  "states": ["Draft", "Sent", "Approved", "Received"],
  "fields": [
    {
      "name": "id",
      "label": "PO ID",
      "fieldtype": "text",
      "readonly": true,
      "hidden": true
    },
    {
      "name": "vendor",
      "label": "Supplier / Vendor",
      "fieldtype": "link",
      "options": "Supplier",
      "required": true
    },
    {
      "name": "date",
      "label": "PO Date",
      "fieldtype": "date",
      "required": true
    },
    {
      "name": "items",
      "label": "Ordered Items",
      "fieldtype": "table",
      "options": "Purchase Order Item",
      "required": true
    },
    {
      "name": "total",
      "label": "Total Amount (₹)",
      "fieldtype": "float",
      "readonly": true
    },
    {
      "name": "status",
      "label": "Status",
      "fieldtype": "select",
      "options": "Draft,Sent,Approved,Received",
      "default": "Draft"
    }
  ]
}
