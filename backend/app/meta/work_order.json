
{
  "name": "Work Order",
  "module": "Manufacturing",
  "fields": [
    { "name": "id", "label": "Work Order ID", "type": "text", "disabled": true },
    { "name": "production_item", "label": "Item to Produce", "type": "select", "options": "Link:Product", "required": true },
    { "name": "bom_no", "label": "BOM No", "type": "select", "options": "Link:BOM", "required": true },
    { "name": "qty", "label": "Qty to Produce", "type": "number", "default": 1 },
    { "name": "fg_warehouse", "label": "Store Finished Good In", "type": "select", "options": "Link:Warehouse", "required": true },
    { "name": "status", "label": "Status", "type": "select", "options": ["Draft", "Submitted", "In Progress", "Completed", "Stopped"], "default": "Draft" },
    { "name": "planned_start", "label": "Planned Start Date", "type": "date" },
    { "name": "produced_qty", "label": "Produced Qty", "type": "number", "disabled": true }
  ]
}
